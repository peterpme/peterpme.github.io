---
import DocView from "../../components/Doc.astro";
import { getByKind, getDoc } from "../../lib/content";

export function getStaticPaths() {
  return getByKind("article").map((doc) => ({ params: { slug: doc.slug } }));
}

const slug = Astro.params.slug;
if (!slug) throw new Error("Missing article slug");
const doc = getDoc("article", slug);
---

<DocView doc={doc} />
