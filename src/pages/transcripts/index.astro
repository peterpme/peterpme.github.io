---
import Base from "../../layouts/Base.astro";
import { formatFull, getByKind, isoDate } from "../../lib/content";

const transcripts = getByKind("transcript");
const description = "Full transcripts of talks, with slides and timestamp links back to the video.";
---

<Base title="Transcripts" description={description}>
  <section class="band page-index">
    <div class="wrap">
      <header class="page-head">
        <h1>Transcripts</h1>
        <p class="dek">{description}</p>
      </header>
      <ol>
        {
          transcripts.map((doc) => (
            <li class="entry">
              <time datetime={isoDate(doc.date)}>{formatFull(doc.date)}</time>
              <div>
                <a class="entry-title" href={doc.href}>
                  {doc.title}
                </a>
                {doc.description ? <p class="entry-dek">{doc.description}</p> : null}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Base>
