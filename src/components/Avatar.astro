---
import { Picture } from "astro:assets";
import source from "../assets/profile-pic.jpg";

interface Props {
  size: number;
  eager?: boolean;
}

const { size, eager = false } = Astro.props;
if (size > source.width) {
  throw new Error(`Avatar CSS size ${size}px exceeds the ${source.width}px source`);
}
// 2x and 3x of the CSS size, but never a bitmap larger than the source.
const densities = [2, 3].filter((density) => density * size <= source.width);
---

<span class="avatar-frame" style={`width:${size}px;height:${size}px`}>
  <Picture
    src={source}
    formats={["avif", "webp"]}
    fallbackFormat="jpg"
    densities={densities.length > 0 ? densities : [1]}
    width={size}
    height={size}
    quality={90}
    alt=""
    class="avatar"
    loading={eager ? "eager" : "lazy"}
    decoding="async"
  />
</span>
