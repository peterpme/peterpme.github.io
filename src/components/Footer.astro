---
import { AUTHOR, SOCIAL, TAGLINE } from "../lib/site";
---

<footer class="site-footer">
  <div class="wrap footer-row">
    <div>
      <p class="footer-name">{AUTHOR}</p>
      <p class="footer-role">{TAGLINE}</p>
    </div>
    <ul class="footer-links">
      {
        SOCIAL.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
