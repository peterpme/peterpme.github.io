{
  "name": "peterpme",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "prepare:site": "node --experimental-strip-types scripts/prepare.ts",
    "dev": "pnpm run prepare:site && astro dev",
    "build": "pnpm run prepare:site && astro build && node --experimental-strip-types scripts/check.ts",
    "preview": "astro preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^5.18.2",
    "gray-matter": "^4.0.3",
    "marked": "^18.0.0",
    "peterpme-sharp-prebuild": "file:scripts/sharp-prebuild",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "satori": "^0.18.3",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2"
  }
}
