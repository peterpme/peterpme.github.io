---
import Base from "../../layouts/Base.astro";
import Byline from "../../components/Byline.astro";
import ContentPicture from "../../components/ContentPicture.astro";
import slide from "../../assets/what-happens-on-send.jpg";
import { AUTHOR } from "../../lib/site";
import { renderMarkdown } from "../../lib/markdown";
import { formatFull, getFeatured, isoDate } from "../../lib/posts";

const post = getFeatured();
const splitAt = post.body.indexOf("## Hitting send");
if (splitAt < 0) throw new Error("Expected the Hitting send section");
const introHtml = renderMarkdown(post.body.slice(0, splitAt));
const restHtml = renderMarkdown(post.body.slice(splitAt));
const category = post.categories[0] ?? "Essay";
---

<Base title={`${post.title} | ${AUTHOR}`} description={post.description} current="writing">
  <article class="article">
    <div class="wrap">
      <p class="kicker"><a href="/">Writing</a> / {category}</p>
      <div class="rule" aria-hidden="true"></div>
      <h1>{post.title}</h1>
      <p class="standfirst">{post.description}</p>
      <p class="meta-line">
        <time datetime={isoDate(post.date)}>{formatFull(post.date)}</time>
        <span aria-hidden="true"> · </span>
        <span>{post.minutes} min read</span>
      </p>
      <Byline eager />
      <div class="prose" set:html={introHtml} />
      <figure class="figure">
        <ContentPicture
          src={slide}
          alt="What happens on send. A slide from Lee Robinson's talk: the app, the server, and the agent's computer."
        />
        <figcaption>
          Slide from <a href="/transcripts/how-grok-bot-works/">the transcript</a> of Lee's talk.
        </figcaption>
      </figure>
      <div class="prose" set:html={restHtml} />
      <footer class="colophon">
        <div class="rule" aria-hidden="true"></div>
        <p>{AUTHOR} · <time datetime={isoDate(post.date)}>{formatFull(post.date)}</time></p>
      </footer>
    </div>
  </article>
</Base>
