---
import Base from "../layouts/Base.astro";
import Avatar from "../components/Avatar.astro";
import { AUTHOR, TAGLINE } from "../lib/site";
import {
  formatArchive,
  formatFull,
  formatShort,
  getArchive,
  getFeatured,
  getRecent,
  groupByYear,
  isoDate,
} from "../lib/posts";

const featured = getFeatured();
const recent = groupByYear(getRecent());
const archive = getArchive();
const archiveYears =
  archive.length > 0
    ? `${archive[archive.length - 1].year}–${archive[0].year}`
    : "";
---

<Base title={AUTHOR} description={TAGLINE} current="writing">
  <section class="hero">
    <div class="wrap">
      <p class="kicker">Deep dive{featured.categories[0] ? ` · ${featured.categories[0]}` : ""}</p>
      <div class="rule" aria-hidden="true"></div>
      <h1><a href={featured.href}>{featured.title}</a></h1>
      <p class="dek">{featured.description}</p>
      <a class="read" href={featured.href}>Read the essay</a>
      <div class="byline">
        <a href="/about/">
          <Avatar size={56} eager />
        </a>
        <div class="byline-copy">
          <a class="byline-name" href="/about/">{AUTHOR}</a>
          <p class="byline-role">{TAGLINE}</p>
        </div>
        <p class="byline-meta">
          <time datetime={isoDate(featured.date)}>{formatFull(featured.date)}</time>
          <span>{featured.minutes} min read</span>
        </p>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="recent-heading">
    <div class="wrap">
      <div class="band-head">
        <h2 id="recent-heading">Recent</h2>
      </div>
      {
        recent.map((group) => (
          <div class="year-group">
            <h3>{group.year}</h3>
            <ol>
              {group.posts.map((post) => (
                <li>
                  <div class="entry">
                    <time datetime={isoDate(post.date)}>{formatShort(post.date)}</time>
                    <span class="entry-title">{post.title}</span>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </div>
  </section>

  <section class="band" aria-labelledby="archive-heading">
    <div class="wrap">
      <div class="band-head">
        <h2 id="archive-heading">Archive</h2>
        <p>{archiveYears}</p>
      </div>
      <ol class="archive-grid">
        {
          archive.map((post) => (
            <li class="entry entry-archive">
              <time datetime={isoDate(post.date)}>{formatArchive(post.date)}</time>
              <span class="entry-title">{post.title}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Base>
