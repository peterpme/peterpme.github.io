---
interface Props {
  current: "writing" | "about";
}

const { current } = Astro.props;

const links = [
  { id: "writing", label: "Writing", href: "/" },
  { id: "about", label: "About", href: "/about/" },
] as const;
---

<header class="site-header">
  <div class="wrap header-row">
    <a class="brand" href="/">peterp.me</a>
    <div class="header-tools">
      <nav aria-label="Primary">
        <ul class="nav-list">
          {
            links.map((link) => (
              <li>
                <a
                  class="nav-link"
                  href={link.href}
                  aria-current={link.id === current ? "page" : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <button type="button" id="theme-toggle" class="theme-toggle" aria-label="Switch color theme">
        <span class="show-in-dark">
          <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
            <circle cx="8" cy="8" r="2.6" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
            <path
              d="M8 1.4v1.7M8 12.9v1.7M1.4 8h1.7M12.9 8h1.7M3.3 3.3l1.2 1.2M11.5 11.5l1.2 1.2M3.3 12.7l1.2-1.2M11.5 4.5l1.2-1.2"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"></path>
          </svg>
          Light
        </span>
        <span class="show-in-light">
          <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
            <path
              d="M9.1 1.7a5.6 5.6 0 1 0 5.1 8.4A4.5 4.5 0 0 1 9.1 1.7z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linejoin="round"></path>
          </svg>
          Dark
        </span>
      </button>
    </div>
  </div>
</header>
