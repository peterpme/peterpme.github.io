---
import Avatar from "./Avatar.astro";
import { AUTHOR, TAGLINE } from "../lib/site";

interface Props {
  eager?: boolean;
}

const { eager = false } = Astro.props;
---

<div class="byline">
  <a href="/about/">
    <Avatar size={56} eager={eager} />
  </a>
  <div class="byline-copy">
    <a class="byline-name" href="/about/">{AUTHOR}</a>
    <p class="byline-role">{TAGLINE}</p>
  </div>
  <slot />
</div>
